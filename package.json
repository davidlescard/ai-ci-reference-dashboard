{
  "name": "quality-gate-lab",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev:api": "pnpm --filter @qgl/api dev",
    "dev:web": "pnpm --filter @qgl/web dev",
    "build": "pnpm --filter @qgl/web build && pnpm --filter @qgl/api build",
    "start": "pnpm --filter @qgl/api start",
    "compile": "pnpm -r --if-present compile",
    "test": "pnpm --filter @qgl/api test",
    "test:e2e": "pnpm --filter ai-ci-reference-e2e test"
  }
}
