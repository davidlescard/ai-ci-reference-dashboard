{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
        "@fixtures/*": ["./src/fixtures/*"],
        "@components/*": ["./src/components/*"],
        "@pages/*": ["./src/pages/*"],
    }
  },
  "include": ["src", "tests", "playwright.config.ts"]
}
