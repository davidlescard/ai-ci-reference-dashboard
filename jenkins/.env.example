JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me
JENKINS_URL=http://localhost:8080/
# Fine-grained personal access token with read-only access to the repository contents, metadata and pull requests.
GITHUB_USER=davidlescard
GITHUB_TOKEN=
# Optional. Classic personal access token with the write:packages scope (fine-grained tokens do not support ghcr.io).
# Leave empty to skip publishing images; staging then deploys the locally built image.
GHCR_TOKEN=
